# Server
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# MongoDB (URL metadata - source of truth)
MONGO_URI=mongodb://localhost:27017/url_shortener

# Redis (cache + rate limiting + BullMQ queue broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache
CACHE_TTL_SECONDS=3600

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_CREATE_MAX=10

# ID generation: "counter" (Redis INCR, sequential, zero collisions)
# or "random" (nanoid-style, needs collision retry)
SHORT_CODE_STRATEGY=counter
SHORT_CODE_LENGTH=7
